{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/ie-daily-control",
    "build": "npm run build --workspace=@workspace/ie-daily-control",
    "start": "npm run start --workspace=@workspace/ie-daily-control",
    "typecheck": "tsc --build",
    "lint": "npm run typecheck --workspace=@workspace/ie-daily-control"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
